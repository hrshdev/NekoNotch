<UserControl x:Class="NekoNotch.Tools.SportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:NekoNotch.Shell">
    <UserControl.Resources>
        <!-- Sport Pill Radio Button -->
        <Style x:Key="SportNavPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip Button for Leagues -->
        <Style x:Key="LeagueChipBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="9,3.5" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action / Toggle Chip Style -->
        <Style x:Key="ActionChip" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6,2,6,4">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header Nav Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: League Filter Chips -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Content Area (Schedule Grid / Detail / Team Follower) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP HEADER NAV BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Sport Toggle Pills -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Football -->
                <RadioButton x:Name="NavFootball" Style="{StaticResource SportNavPill}" GroupName="SportsNav" IsChecked="True" Click="OnNavFootballClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚽ Football" VerticalAlignment="Center" />
                        <Ellipse x:Name="FootballLiveDot" Width="6" Height="6" Fill="#32D74B" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>

                <!-- Cricket -->
                <RadioButton x:Name="NavCricket" Style="{StaticResource SportNavPill}" GroupName="SportsNav" Click="OnNavCricketClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏏 Cricket" VerticalAlignment="Center" />
                        <Ellipse x:Name="CricketLiveDot" Width="6" Height="6" Fill="#32D74B" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    </StackPanel>
                </RadioButton>

                <!-- My Teams -->
                <RadioButton x:Name="NavMyTeams" Style="{StaticResource SportNavPill}" GroupName="SportsNav" Click="OnNavMyTeamsClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Star" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Following" VerticalAlignment="Center" />
                        <Border x:Name="MyTeamsBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="4,1" Margin="5,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="MyTeamsCountText" Text="0" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <!-- Right: Search, Live Filter, Follow Teams & Refresh -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Live Only Toggle Pill -->
                <CheckBox x:Name="LiveFilterCheck" Margin="0,0,8,0" Cursor="Hand" Click="OnLiveFilterClick" VerticalAlignment="Center">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Bd" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#32D74B" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Txt" Text="Live Only" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#2532D74B" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#32D74B" />
                                    <Setter TargetName="Txt" Property="Foreground" Value="#32D74B" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>

                <!-- Search Input -->
                <TextBox x:Name="SearchBox" Width="130" Height="25" Margin="0,0,6,0"
                         Tag="Search games..." Style="{StaticResource InlineField}" FontSize="10.5"
                         VerticalContentAlignment="Center" TextChanged="OnSearchChanged" />

                <!-- Follow Teams Button -->
                <Button x:Name="FollowTeamsBtn" Style="{StaticResource ActionChip}" Margin="0,0,6,0"
                        ToolTip="Follow Favorite Clubs &amp; Teams" Click="OnToggleFollowModeClick">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Plus" Width="10" Height="10" Margin="0,0,3,0" VerticalAlignment="Center" />
                        <TextBlock Text="Teams" FontSize="10" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Refresh Button -->
                <Button Style="{StaticResource IconButton}" Width="25" Height="25"
                        ToolTip="Refresh Live Scores" Click="OnRefreshClick" Foreground="{DynamicResource SubTextBrush}">
                    <hero:HeroIcon Kind="Refresh" Width="13" Height="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ROW 1: LEAGUE FILTER CHIPS -->
        <ScrollViewer x:Name="LeagueChipsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
            <StackPanel x:Name="LeagueChipsPanel" Orientation="Horizontal" />
        </ScrollViewer>

        <!-- ROW 2: MAIN CONTENT AREA -->
        <Grid Grid.Row="2">
            <!-- MODE A: FIXTURE LIST VIEW -->
            <Grid x:Name="StageScheduleMode" Visibility="Visible">
                <ScrollViewer x:Name="MatchesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <ItemsControl x:Name="MatchesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="344" Height="86" Margin="4,3,4,5" Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10"
                                            Padding="10,6" Cursor="Hand" MouseLeftButtonUp="OnMatchCardClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="18" />
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="20" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Top: League + Status + Pin -->
                                            <Grid Grid.Row="0">
                                                <TextBlock Text="{Binding LeagueName}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                                                           MaxWidth="200" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Border Background="{Binding StatusBgBrush}" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding StatusDetail}" FontSize="9" FontWeight="Bold" Foreground="{Binding StatusFgBrush}" />
                                                    </Border>
                                                    <Button Style="{StaticResource IconButton}" Width="18" Height="18"
                                                            ToolTip="{Binding PinToolTip}" Click="OnPinItemClick" Tag="{Binding Id}">
                                                        <hero:HeroIcon Kind="Pin" Width="10" Height="10" Foreground="{Binding PinColor}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Home Team Row -->
                                            <Grid Grid.Row="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#14FFFFFF" Margin="0,0,6,0">
                                                        <Image Source="{Binding HomeTeamLogo}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <TextBlock Text="{Binding HomeTeamName}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding HomeScore}" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Away Team Row -->
                                            <Grid Grid.Row="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#14FFFFFF" Margin="0,0,6,0">
                                                        <Image Source="{Binding AwayTeamLogo}" Width="14" Height="14" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <TextBlock Text="{Binding AwayTeamName}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding AwayScore}" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Summary / Context note -->
                                            <TextBlock Grid.Row="3" Text="{Binding Summary}" FontSize="9" Foreground="{DynamicResource SubTextBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,1,0,0"
                                                       Visibility="{Binding HasSummary, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <StackPanel x:Name="NoMatchesState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,35,0,0" Visibility="Collapsed">
                            <hero:HeroIcon Kind="Trophy" Width="28" Height="28" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="No matches scheduled for this selection" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Try selecting 'All', turning off 'Live Only', or follow your favorite teams." FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- MODE B: DETAILED SCORECARD VIEW -->
            <Grid x:Name="StageDetailMode" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Bar: Back & Pin -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Button Style="{StaticResource ActionChip}" HorizontalAlignment="Left" Padding="8,4" Click="OnBackToScheduleClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <hero:HeroIcon Kind="ChevronLeft" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="Back to Games" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="TestCelebrationBtn" Style="{StaticResource ActionChip}" Margin="0,0,6,0" Padding="8,4" Click="OnTestCelebrationClick" ToolTip="Test celebration notification &amp; in-notch spin">
                            <StackPanel Orientation="Horizontal">
                                <hero:HeroIcon Kind="Sparkles" Width="11" Height="11" Margin="0,0,4,0" />
                                <TextBlock Text="Test Alert" FontSize="10" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="DetailPinBtn" Style="{StaticResource ActionChip}" Click="OnDetailPinClick">
                            <StackPanel Orientation="Horizontal">
                                <hero:HeroIcon x:Name="DetailPinIcon" Kind="Pin" Width="11" Height="11" Margin="0,0,4,0" />
                                <TextBlock x:Name="DetailPinText" Text="Pin to Notch" FontSize="10" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Big Match Header -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Home -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#18FFFFFF" Margin="0,0,0,3">
                                <Image x:Name="DetailHomeLogo" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock x:Name="DetailHomeName" Text="Home" FontSize="11.5" FontWeight="Bold" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                        </StackPanel>

                        <!-- Score & Clock -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0">
                            <TextBlock x:Name="DetailScoreText" Text="0 - 0" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" />
                            <Border x:Name="DetailStatusBadge" Background="#2032D74B" CornerRadius="4" Padding="6,1.5" Margin="0,3,0,0" HorizontalAlignment="Center">
                                <TextBlock x:Name="DetailStatusText" Text="LIVE" FontSize="9.5" FontWeight="Bold" Foreground="#32D74B" />
                            </Border>
                        </StackPanel>

                        <!-- Away -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#18FFFFFF" Margin="0,0,0,3">
                                <Image x:Name="DetailAwayLogo" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock x:Name="DetailAwayName" Text="Away" FontSize="11.5" FontWeight="Bold" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Deep Detail Body -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Football Stats & Timeline Panel -->
                        <StackPanel x:Name="FootballDetailPanel" Visibility="Visible">
                            <!-- Possession & Shots Bar -->
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,8" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock x:Name="HomePossessionText" Text="50%" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Left" />
                                        <TextBlock Text="Possession" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="AwayPossessionText" Text="50%" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Height="6" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="HomePossessionCol" Width="50*" />
                                            <ColumnDefinition x:Name="AwayPossessionCol" Width="50*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{DynamicResource AccentBrush}" CornerRadius="3,0,0,3" />
                                        <Border Grid.Column="1" Background="#35FFFFFF" CornerRadius="0,3,3,0" />
                                    </Grid>

                                    <!-- Shots on Target -->
                                    <Grid>
                                        <TextBlock x:Name="HomeShotsText" Text="0" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                        <TextBlock Text="Shots on Target" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="AwayShotsText" Text="0" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Goals & Cards Events Timeline -->
                            <TextBlock Text="KEY MATCH EVENTS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" Margin="2,0,0,4" />
                            <ItemsControl x:Name="FootballEventsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#25FFFFFF" CornerRadius="4" Padding="4,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Clock}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="10.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Cricket Scorecard & Match Details Panel -->
                        <StackPanel x:Name="CricketDetailPanel" Visibility="Collapsed">
                            <!-- Innings Selector Chips (when multiple innings exist) -->
                            <ScrollViewer x:Name="CricketInningsTabsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                                <StackPanel x:Name="CricketInningsTabsPanel" Orientation="Horizontal" />
                            </ScrollViewer>

                            <!-- Loading State -->
                            <StackPanel x:Name="CricketLoadingPanel" HorizontalAlignment="Center" Margin="0,20,0,20" Visibility="Collapsed">
                                <TextBlock Text="Loading match scorecard..." FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" FontStyle="Italic" />
                            </StackPanel>

                            <!-- Selected Inning Scorecard Card -->
                            <Border x:Name="CricketScorecardCard" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Visibility="Collapsed">
                                <StackPanel>
                                    <!-- Inning Title & Score Header -->
                                    <Grid Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="InningHeaderTitle" Text="Scorecard" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="InningHeaderScore" Text="" FontSize="11.5" FontWeight="Black" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="InningHeaderExtras" Text="" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- BATTING SECTION -->
                                    <TextBlock x:Name="BattingHeading" Text="BATTING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,4" />
                                    <!-- Batting Table Header -->
                                    <Grid x:Name="BattingTableHeader" Margin="0,0,0,4" Opacity="0.7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Batter" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="Dismissal" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="R" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="B" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="4s" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="6s" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="SR" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Right" />
                                    </Grid>

                                    <!-- Batters List -->
                                    <ItemsControl x:Name="CricketBattersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="0,3.5" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="34" />
                                                            <ColumnDefinition Width="48" />
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Batter Name with Not Out indicator -->
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayNameWithStar}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="145" VerticalAlignment="Center" />
                                                        <!-- Dismissal -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Dismissal}" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0,8,0" />
                                                        <!-- Runs -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Runs}" FontSize="10.5" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" Foreground="{Binding RunsBrush}" />
                                                        <!-- Balls -->
                                                        <TextBlock Grid.Column="3" Text="{Binding Balls}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                                        <!-- 4s -->
                                                        <TextBlock Grid.Column="4" Text="{Binding Fours}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                                        <!-- 6s -->
                                                        <TextBlock Grid.Column="5" Text="{Binding Sixes}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                                        <!-- SR -->
                                                        <TextBlock Grid.Column="6" Text="{Binding StrikeRate}" FontSize="9.5" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Empty Batters State -->
                                    <TextBlock x:Name="NoBattersText" Text="Yet to bat" FontSize="9.5" FontStyle="Italic" Foreground="{DynamicResource SubTextBrush}" Margin="2,4,0,4" Visibility="Collapsed" />

                                    <!-- BOWLING SECTION -->
                                    <TextBlock x:Name="BowlingHeading" Text="BOWLING" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" Margin="0,10,0,4" />
                                    <!-- Bowling Table Header -->
                                    <Grid x:Name="BowlingTableHeader" Margin="0,0,0,4" Opacity="0.7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Bowler" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="O" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="M" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="R" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="W" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="6" Text="Econ" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" TextAlignment="Right" />
                                    </Grid>

                                    <!-- Bowlers List -->
                                    <ItemsControl x:Name="CricketBowlersList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="0,3.5" BorderBrush="#12FFFFFF" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="180" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="38" />
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="48" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding BowlerName}" FontSize="10.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Overs}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Maidens}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                                        <TextBlock Grid.Column="4" Text="{Binding RunsConceded}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Wickets}" FontSize="10.5" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" Foreground="{Binding WicketsBrush}" />
                                                        <TextBlock Grid.Column="6" Text="{Binding Economy}" FontSize="9.5" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- FALL OF WICKETS -->
                                    <StackPanel x:Name="FowSection" Margin="0,10,0,0" Visibility="Collapsed">
                                        <TextBlock Text="FALL OF WICKETS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4" />
                                        <ItemsControl x:Name="CricketFowList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2.5" Margin="0,0,5,4">
                                                        <TextBlock Text="{Binding Formatted}" FontSize="9" Foreground="{DynamicResource SubTextBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- PARTNERSHIPS -->
                                    <StackPanel x:Name="PartnershipsSection" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock Text="KEY PARTNERSHIPS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,0,4" />
                                        <ItemsControl x:Name="CricketPartnershipsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,3" Margin="0,0,0,3">
                                                        <TextBlock Text="{Binding Formatted}" FontSize="9.5" Foreground="{DynamicResource SubTextBrush}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- SQUADS & PLAYING XI ACCORDION -->
                            <Border x:Name="SquadsAccordionCard" Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,8" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid Cursor="Hand" MouseLeftButtonUp="OnToggleSquadsClick" Background="Transparent">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <hero:HeroIcon Kind="User" Width="13" Height="13" Margin="0,0,6,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SquadsToggleTitle" Text="PLAYING XI &amp; SQUADS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="SquadsToggleBtnText" Text="Show" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" Margin="0,0,4,0" />
                                                <hero:HeroIcon x:Name="SquadsToggleArrow" Kind="ChevronDown" Width="10" Height="10" Foreground="{DynamicResource SubTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Expanded Squads Content -->
                                    <StackPanel x:Name="SquadsContentPanel" Visibility="Collapsed" Margin="0,10,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Home Team XI -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Name="HomeSquadTitle" Text="Home Team" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,5" />
                                                <ItemsControl x:Name="HomeSquadList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#14FFFFFF" CornerRadius="5" Padding="7,4" Margin="0,0,0,3">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                                    <TextBlock Text="{Binding Role}" FontSize="8.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Away Team XI -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="AwaySquadTitle" Text="Away Team" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,5" />
                                                <ItemsControl x:Name="AwaySquadList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#14FFFFFF" CornerRadius="5" Padding="7,4" Margin="0,0,0,3">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                                    <TextBlock Text="{Binding Role}" FontSize="8.5" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- MODE C: CLUSTERED FOLLOW TEAMS DRAWER / MODAL -->
            <Grid x:Name="StageFollowMode" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Margin="0,0,6,0" Click="OnBackFromFollowClick">
                            <hero:HeroIcon Kind="ChevronLeft" Width="12" Height="12" />
                        </Button>
                        <TextBlock x:Name="FollowModeTitle" Text="FOLLOW CLUBS &amp; NATIONAL TEAMS" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox x:Name="TeamSearchBox" Width="140" Height="24" Margin="0,0,6,0"
                                 Tag="Search teams..." Style="{StaticResource InlineField}" FontSize="10"
                                 VerticalContentAlignment="Center" TextChanged="OnTeamSearchChanged" />
                        <Button Style="{StaticResource ActionChip}" Padding="8,3" Click="OnBackFromFollowClick">
                            <TextBlock Text="✕ Done" FontSize="9.5" FontWeight="Bold" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Category Filter Chips for Teams -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                    <StackPanel x:Name="TeamCategoryChipsPanel" Orientation="Horizontal" />
                </ScrollViewer>

                <!-- Clustered Teams Grid -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TeamClustersControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <!-- Cluster Header with Badge -->
                                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="8,3.5" Margin="4,0,4,6" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Teams in this cluster -->
                                    <ItemsControl ItemsSource="{Binding Teams}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="225" Margin="4,3,4,4" Background="{DynamicResource SurfaceBrush}"
                                                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Logo -->
                                                        <Border Width="22" Height="22" CornerRadius="11" Background="#14FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Image Source="{Binding LogoUrl}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>

                                                        <!-- Name -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,4,0" />

                                                        <!-- Follow Button -->
                                                        <Button Grid.Column="2" Style="{StaticResource ActionChip}" Padding="6,2"
                                                                Click="OnToggleFollowTeamClick" Tag="{Binding Id}">
                                                            <TextBlock Text="{Binding FollowButtonText}" FontSize="9.5" FontWeight="Bold"
                                                                       Foreground="{Binding FollowButtonColor}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>