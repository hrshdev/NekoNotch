<UserControl x:Class="NekoNotch.Tools.SportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:NekoNotch.Shell">
    <Grid Margin="2,0,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sport Filter Chips -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="FilterAllBtn" Content="All Sports" Style="{StaticResource Chip}"
                        Margin="0,0,6,0" Padding="10,4" Click="OnFilterAll" />
                <Button x:Name="FilterFootballBtn" Content="⚽ Football" Style="{StaticResource Chip}"
                        Margin="0,0,6,0" Padding="10,4" Click="OnFilterFootball" />
                <Button x:Name="FilterCricketBtn" Content="🏏 Cricket" Style="{StaticResource Chip}"
                        Padding="10,4" Click="OnFilterCricket" />
            </StackPanel>

            <!-- Status Indicator -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="LiveIndicator" Width="7" Height="7" Fill="#32D74B" Margin="0,0,6,0" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Text="Live Sports &amp; Scorecards" Style="{StaticResource SubText}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" ToolTip="Refresh Scores" Click="OnRefreshClick"
                        Foreground="{DynamicResource SubTextBrush}" Margin="0,0,6,0">
                    <hero:HeroIcon Kind="Refresh" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Area: Split Spotlight Card & Fixture List -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Featured / Pinned Live Match Card -->
            <Border Grid.Column="0" Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="14,12" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- League & Status Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="SpotlightLeagueText" Text="PREMIER LEAGUE" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                        <Border x:Name="SpotlightStatusBadge" HorizontalAlignment="Right" Background="#2532D74B" CornerRadius="4" Padding="6,2">
                            <TextBlock x:Name="SpotlightStatusText" Text="LIVE 74'" FontSize="10" FontWeight="Bold" Foreground="#32D74B" />
                        </Border>
                    </Grid>

                    <!-- Scoreboard Row -->
                    <Grid Grid.Row="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Home Team -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#18FFFFFF" Margin="0,0,0,6">
                                <Image x:Name="SpotlightHomeLogo" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock x:Name="SpotlightHomeName" Text="ARS" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                        </StackPanel>

                        <!-- Score Display -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock x:Name="SpotlightScoreText" Text="2 - 1" FontSize="26" FontWeight="Black"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock x:Name="SpotlightTimeText" Text="Second Half" FontSize="10"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Away Team -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#18FFFFFF" Margin="0,0,0,6">
                                <Image x:Name="SpotlightAwayLogo" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock x:Name="SpotlightAwayName" Text="CHE" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90" />
                        </StackPanel>
                    </Grid>

                    <!-- Footer: Summary & Pin Button -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock x:Name="SpotlightSummaryText" Text="Saka 68' (Pen), Havertz 34'" FontSize="11"
                                   Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="190" />
                        <Button x:Name="PinToNotchBtn" HorizontalAlignment="Right" Style="{StaticResource Chip}"
                                Padding="8,4" Click="OnPinToNotchClick" ToolTip="Pin match to Dynamic Island Notch">
                            <StackPanel Orientation="Horizontal">
                                <hero:HeroIcon Kind="Pin" Width="11" Height="11" Margin="0,0,4,0" />
                                <TextBlock Text="Pin" FontSize="11" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Matches List -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="MatchesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                    BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Cursor="Hand"
                                    MouseLeftButtonUp="OnMatchRowClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Sport Icon -->
                                    <TextBlock Text="{Binding SportEmoji}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <!-- Teams -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MatchTitle}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LeagueAndSummary}" FontSize="10"
                                                   Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- Score or Time -->
                                    <Border Grid.Column="2" Background="{Binding StatusBgBrush}" CornerRadius="4" Padding="6,2" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusOrScoreText}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding StatusFgBrush}" />
                                    </Border>

                                    <!-- Pin Button -->
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="24" Height="24"
                                            ToolTip="Pin to Notch" Click="OnPinItemClick" Tag="{Binding Id}">
                                        <hero:HeroIcon Kind="Pin" Width="12" Height="12" Foreground="{DynamicResource SubTextBrush}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Quick Follow Chips -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,4,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Quick Follow:" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                <ItemsControl x:Name="QuickPresetsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Chip}" Margin="0,0,5,0" Padding="8,3"
                                    Click="OnQuickFollowClick" Tag="{Binding Id}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
