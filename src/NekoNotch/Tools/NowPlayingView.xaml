<UserControl x:Class="NekoNotch.Tools.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:NekoNotch.Services"
             xmlns:hero="clr-namespace:NekoNotch.Shell"
             DataContext="{x:Static svc:NowPlayingService.Instance}">
    <UserControl.Resources>
        <!-- Round accent play/pause button -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Glow" Fill="{DynamicResource AccentBrush}" Opacity="0.35" Margin="-3">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="10" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Bd" Fill="{DynamicResource AccentBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                <Setter TargetName="Glow" Property="Opacity" Value="0.2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                                <Setter TargetName="Glow" Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="Card" CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource StrokeBrush}"
            Background="{DynamicResource SurfaceBrush}">
        <Grid>
            <!-- Blurred album art backdrop for smooth immersion -->
            <Image x:Name="Backdrop" Source="{Binding Art}" Stretch="UniformToFill" Opacity="0.55"
                   RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                </Image.RenderTransform>
                <Image.Effect>
                    <BlurEffect Radius="40" KernelType="Gaussian" RenderingBias="Performance" />
                </Image.Effect>
            </Image>
            <Border x:Name="Scrim" IsHitTestVisible="False" />

            <Grid Margin="18,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PlayerCol" Width="*" />
                    <ColumnDefinition x:Name="LyricsDividerCol" Width="Auto" />
                    <ColumnDefinition x:Name="LyricsCol" Width="0" />
                </Grid.ColumnDefinitions>

                <!-- Left Pane: Player View -->
                <Grid x:Name="PlayerPane" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Media Thumbnail -->
                    <Border Width="116" Height="116" CornerRadius="14" Background="{DynamicResource Surface2Brush}"
                            VerticalAlignment="Center" Cursor="Hand" ToolTip="Go to playing app or browser tab"
                            MouseLeftButtonUp="OnGoToApp">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <Grid>
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,116,116" RadiusX="14" RadiusY="14" />
                            </Grid.Clip>
                            <hero:HeroIcon Kind="MusicNote" Width="30" Height="30" Foreground="{DynamicResource SubTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{Binding Art}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- Details, Timeline, Controls -->
                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top Row: Source App Caps, Go to App button, and optional Lyrics Toggle -->
                        <Grid>
                            <!-- Clickable Source App Badge -->
                            <Button Style="{StaticResource IconButton}" Height="22" Width="Auto" Padding="6,2"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    ToolTip="Go to playing app or browser tab" Cursor="Hand" Click="OnGoToApp">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SourceApp}" Style="{StaticResource Caps}"
                                               Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                                    <hero:HeroIcon Kind="ArrowRight" Width="9" Height="9" Margin="4,0,0,0"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="LyricsToggle" Style="{StaticResource IconButton}" Width="26" Height="26"
                                        ToolTip="Toggle Lyrics Split View" Foreground="{DynamicResource SubTextBrush}"
                                        Click="OnToggleLyrics" Visibility="Collapsed">
                                    <hero:HeroIcon Kind="Quote" Width="14" Height="14" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Middle Row: Track Title & Artist -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,3,0,5">
                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Artist}" Style="{StaticResource SubText}" FontWeight="Normal" FontSize="12.5"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            <TextBlock x:Name="LyricsStatus" Style="{StaticResource SubText}" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- Timeline Bar -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,6">
                            <ProgressBar x:Name="Progress" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}"
                                         Height="4" Cursor="Hand" MouseLeftButtonDown="OnSeek" />
                            <Grid Margin="0,3,0,0">
                                <TextBlock Text="{Binding PositionText}" Style="{StaticResource SubText}" FontWeight="Normal"
                                           FontSize="11" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="{Binding DurationText}" Style="{StaticResource SubText}" FontWeight="Normal"
                                           FontSize="11" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" />
                            </Grid>
                        </StackPanel>

                        <!-- Playback Controls -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" IsEnabled="{Binding HasSession}">
                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" Command="{Binding PreviousCommand}"
                                    ToolTip="Previous" VerticalAlignment="Center">
                                <hero:HeroIcon Kind="Backward" Width="18" Height="18" />
                            </Button>
                            <Button Style="{StaticResource PlayButton}" Margin="16,0" Command="{Binding PlayPauseCommand}">
                                <hero:HeroIcon x:Name="PlayIcon" Kind="Play" Width="18" Height="18" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Width="34" Height="34" Command="{Binding NextCommand}"
                                    ToolTip="Next" VerticalAlignment="Center">
                                <hero:HeroIcon Kind="Forward" Width="18" Height="18" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Middle Divider (only visible when split lyrics active) -->
                <Border x:Name="LyricsDivider" Grid.Column="1" Width="1" Margin="12,4"
                        Background="{DynamicResource StrokeBrush}" Opacity="0.5" Visibility="Collapsed" />

                <!-- Right Pane: Dedicated Lyrics View (Split Card) -->
                <Grid x:Name="LyricsPane" Grid.Column="2" Visibility="Collapsed" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: Badge + Close button -->
                    <Grid Grid.Row="0" Margin="4,0,2,8">
                        <Border x:Name="LyricsBadge" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left"
                                Background="{DynamicResource Surface2Brush}">
                            <TextBlock x:Name="LyricsBadgeText" Text="♪ Synced" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" HorizontalAlignment="Right"
                                ToolTip="Close Lyrics" Click="OnToggleLyrics" Foreground="{DynamicResource SubTextBrush}">
                            <hero:HeroIcon Kind="XMark" Width="12" Height="12" />
                        </Button>
                    </Grid>

                    <!-- Scrolling Lyrics Sheet -->
                    <ScrollViewer x:Name="LyricsScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden"
                                  IsHitTestVisible="True" Height="152" PreviewMouseWheel="OnLyricsPreviewMouseWheel">
                        <StackPanel x:Name="LyricsLines" Margin="4,2,10,12" />
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
