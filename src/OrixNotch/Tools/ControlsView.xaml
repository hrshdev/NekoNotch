<UserControl x:Class="OrixNotch.Tools.ControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hero="clr-namespace:OrixNotch.Shell">
    <UserControl.Resources>
        <Style x:Key="ControlTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="3,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,0,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top: 8 Essential Quick Toggles (2 rows x 4 columns) -->
        <UniformGrid Grid.Row="0" Columns="4" Rows="2">
            <!-- 1. Wi-Fi -->
            <Border Style="{StaticResource ControlTile}" MouseLeftButtonUp="OnWifiClick" ToolTip="Open Wi-Fi Network Connections">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Wifi" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Wi-Fi" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="WifiStatusText" Text="Networks" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Bluetooth -->
            <Border Style="{StaticResource ControlTile}" MouseLeftButtonUp="OnBluetoothClick" ToolTip="Open Bluetooth &amp; Devices">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Bluetooth" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Bluetooth" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Devices" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Airplane Mode -->
            <Border Style="{StaticResource ControlTile}" MouseLeftButtonUp="OnAirplaneClick" ToolTip="Open Airplane Mode Settings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Rocket" Width="16" Height="16" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Airplane Mode" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Radios" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Night Light -->
            <Border Style="{StaticResource ControlTile}" MouseLeftButtonUp="OnNightLightClick" ToolTip="Open Night Light / Warm Display Settings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Moon" Width="16" Height="16" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Night Light" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Blue filter" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Battery Saver -->
            <Border Style="{StaticResource ControlTile}" MouseLeftButtonUp="OnBatterySaverClick" ToolTip="Open Battery Saver Settings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="BatteryFull" Width="16" Height="16" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Battery Saver" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Energy mode" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6. Do Not Disturb -->
            <Border Style="{StaticResource ControlTile}" MouseLeftButtonUp="OnDndClick" ToolTip="Open Focus / Quiet Hours Settings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Bell" Width="16" Height="16" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Do Not Disturb" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Focus mode" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 7. Snip Screen -->
            <Border Style="{StaticResource ControlTile}" MouseLeftButtonUp="OnSnipClick" ToolTip="Instant Screen Snip (Area Screenshot)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="Photo" Width="16" Height="16" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Snip Screen" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Capture area" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 8. Lock PC -->
            <Border Style="{StaticResource ControlTile}" MouseLeftButtonUp="OnLockClick" ToolTip="Lock Screen Immediately">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Surface2Brush}" VerticalAlignment="Center">
                        <hero:HeroIcon Kind="User" Width="16" Height="16" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="Lock PC" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Lock screen" FontSize="10.5" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Bottom: Dual Hardware Sliders (Brightness & Sound) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Brightness Slider Card -->
            <Border Style="{StaticResource Card}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <hero:HeroIcon Kind="Sun" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Brightness" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="BrightnessValText" Text="67%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="BrightnessSlider" Grid.Row="1" Minimum="0" Maximum="100" Value="67" ValueChanged="OnBrightnessChanged" />
                </Grid>
            </Border>

            <!-- Sound Volume Slider Card -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}" Width="20" Height="20" Margin="0,0,6,0" Click="OnMuteToggle" ToolTip="Toggle Mute">
                                <hero:HeroIcon x:Name="VolumeMuteIcon" Kind="Speaker" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" />
                            </Button>
                            <TextBlock Text="Volume" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="VolumeValText" Text="50%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SubTextBrush}" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="VolumeSlider" Grid.Row="1" Minimum="0" Maximum="100" Value="50" ValueChanged="OnVolumeChanged" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
