<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    NekoNotch MSI — per-user (no admin prompt), installs to %LOCALAPPDATA%\Programs\OrixNotch.
    Built by packaging/Build-Msi.ps1 (MsiFiles.g.wxi holds the published files).

    - Open at login: the installer writes the per-user Run value (removed on uninstall). The app keeps
      it in step with its "Open at login" setting afterwards (StartupService).
    - Starts NekoNotch when the install finishes. Silent installs can skip that:
        msiexec /i NekoNotch-Setup.msi /qn LAUNCHAPP=0
    - A running OrixNotch is closed before files are replaced or removed (upgrade / uninstall).
    - Note: System notification banner settings are overwritten during setup to route alerts exclusively through the Dynamic Island notch.
  -->
  <Package Name="NekoNotch"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="Faisal Shohag"
           UpgradeCode="239535B2-DB36-4B3C-8B2A-CB20F74D39F5"
           Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of NekoNotch is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ProductIcon" SourceFile="$(var.BrandIco)" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/hrshdev/NekoNotch" />
    <Property Id="LAUNCHAPP" Value="1" Secure="yes" />
    <Property Id="ARPCOMMENTS" Value="Note: System notification banner settings are overwritten during setup to route alerts through the NekoNotch Dynamic Island." />

    <Feature Id="Main" Title="NekoNotch" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>

    <!-- Close any running NekoNotch or OrixNotch before replacing files -->
    <SetProperty Id="CloseRunningApp" Value="&quot;[System64Folder]taskkill.exe&quot; /F /IM NekoNotch.exe /IM OrixNotch.exe"
                 Before="CloseRunningApp" Sequence="execute" />
    <CustomAction Id="CloseRunningApp" DllEntry="WixQuietExec64" BinaryRef="Wix4UtilCA_X64"
                  Execute="immediate" Return="ignore" />

    <!-- Start NekoNotch once setup finishes (runs in user desktop session). -->
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]NekoNotch.exe&quot;"
                  Return="asyncNoWait" Impersonate="yes" Execute="immediate" />
    <!-- Overwrite system notification banner settings during setup so only the notch shows them -->
    <SetProperty Id="ConfigureSystemDefaults"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Get-ChildItem 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Notifications\Settings' -ErrorAction SilentlyContinue | ForEach-Object { Set-ItemProperty -Path $_.PSPath -Name 'ShowBanners' -Value 0 -Type DWord -ErrorAction SilentlyContinue }&quot;"
                 Before="ConfigureSystemDefaults" Sequence="execute" />
    <CustomAction Id="ConfigureSystemDefaults" DllEntry="WixQuietExec64" BinaryRef="Wix4UtilCA_X64"
                  Execute="immediate" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="CloseRunningApp" Before="InstallValidate" />
      <Custom Action="ConfigureSystemDefaults" Before="InstallFinalize" Condition="NOT REMOVE" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="LAUNCHAPP = &quot;1&quot; AND NOT REMOVE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="NekoNotch" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles">
      <!-- Per-user components use an HKCU value as their key path. -->
      <Component Id="AppBinaries" Guid="F7F051E2-3345-4233-8CD8-C74B782A0D04" Directory="INSTALLFOLDER" Bitness="always64">
        <RegistryValue Root="HKCU" Key="Software\NekoNotch" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <?include MsiFiles.g.wxi?>
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      </Component>

      <Component Id="StartMenu" Directory="ProgramMenuFolder" Bitness="always64">
        <RegistryValue Root="HKCU" Key="Software\NekoNotch" Name="StartMenuShortcut" Value="1" Type="integer" KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut" Name="NekoNotch" Target="[#MainExe]"
                  WorkingDirectory="INSTALLFOLDER" Icon="ProductIcon" Advertise="no" />
      </Component>

      <Component Id="OpenAtLogin" Directory="INSTALLFOLDER" Bitness="always64">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="NekoNotch"
                       Value="&quot;[INSTALLFOLDER]NekoNotch.exe&quot;" Type="string" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
